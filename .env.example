# PostgreSQL (Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db"

# App URL (used by Stripe, emails, BetterAuth — set to your production domain)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# BetterAuth
BETTER_AUTH_SECRET=""          # generate with: openssl rand -base64 32

# Google sign-in (optional). Create an OAuth client in Google Cloud Console with
# redirect URI <NEXT_PUBLIC_APP_URL>/api/auth/callback/google. Leave empty to
# hide the "Continue with Google" button on /login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"

# Demo mode (set to "true" for local dev with demo personas, "false" for real auth).
# In production builds (NODE_ENV=production) demo mode is ignored unless
# ALLOW_DEMO_IN_PROD is also set — this prevents accidental exposure of the
# persona switcher in real customer environments.
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# Intentional demo deploys (e.g. demo.brandbite.studio) opt back in to demo
# mode in production by setting these. Do NOT set in real customer envs.
# ALLOW_DEMO_IN_PROD=""
# NEXT_PUBLIC_ALLOW_DEMO_IN_PROD=""

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend Email
RESEND_API_KEY=""
EMAIL_FROM="BrandBite <notifications@brandbite.studio>"

# Cloudflare R2 (S3-compatible file storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="brandbite-assets"
R2_REGION="auto"
R2_ENDPOINT=""
# R2_PUBLIC_BASE_URL=""        # optional: custom domain for public assets

# AI Tools (OpenAI + Replicate)
OPENAI_API_KEY=""                # Required for GPT-4o text gen + DALL-E 3 image gen
# OPENAI_ORG_ID=""              # Optional: OpenAI organization ID
REPLICATE_API_TOKEN=""           # Required for Flux Pro image gen + RMBG background removal

# Sentry
NEXT_PUBLIC_SENTRY_DSN=""

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX). Loaded on public
# marketing pages only, behind a cookie consent banner. Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Upstash Redis (rate limiter — production only).
# When unset, rate limiting falls back to an in-memory Map which does NOT
# work across multiple Vercel serverless instances. Set the URL + TOKEN
# pair using any of these conventions (lib/rate-limit.ts checks all three,
# preferring the first that is set):
#
#   1. UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN — explicit names.
#   2. KV_REST_API_URL / KV_REST_API_TOKEN — Upstash SDK convention.
#   3. UPSTASH_REDIS_REST_KV_REST_API_URL / ..._TOKEN — what Vercel's
#      Upstash marketplace integration auto-injects when you pick the
#      "UPSTASH_REDIS_REST" prefix during setup.
#
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# WordPress plugin licences
#
# Signs the short-lived download tokens handed out by
# /api/plugins/<product>/version. Without it licence activation and checking
# still work, but no site can install a plugin update.
#
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
PLUGIN_DOWNLOAD_SECRET=""

# Customer integrations (Google Drive / Dropbox delivery, Slack).
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means every customer has to reconnect; rotate via INTEGRATIONS_ENCRYPTION_KEYS_OLD="k0=<old key>".
INTEGRATIONS_ENCRYPTION_KEY=""
INTEGRATIONS_ENCRYPTION_KEYS_OLD=""
# Google Drive delivery: its own Google Cloud project ("brandbite"), separate from the
# calendar's. OAuth client redirect URI: https://<host>/api/customer/integrations/google-drive/callback
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_ENABLED="false"
# Dropbox delivery: a Scoped access app with "App folder" access (Apps/<folder>).
# Permissions: account_info.read, files.metadata.read, files.content.write, files.content.read.
# Redirect URI: https://<host>/api/customer/integrations/dropbox/callback
DROPBOX_APP_KEY=""
DROPBOX_APP_SECRET=""
# The app folder's name in the customer's Dropbox (defaults to "brandbite").
DROPBOX_APP_FOLDER_NAME=""
DROPBOX_ENABLED="false"
# Slack app (api.slack.com/apps): OAuth scope incoming-webhook only; redirect
# URL https://<host>/api/customer/integrations/slack/callback. Customers pick
# the channel on Slack's consent screen; we post request updates there.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_ENABLED="false"
